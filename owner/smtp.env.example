# Copy these settings to the application's root directory as capstone-mail.env.
# Keep the root .htaccess file in place to block direct web access to this file.
# For Gmail, use a Google App Password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
SMTP_FROM_NAME=Josefina Farmacia
